@page "/{milieu}/{sector}/{subsector}/{hex}"
@model GTStarCharts.Pages.SystemDataModel
@using GTStarData
@{
}

<div class="text-center">
    <h3 class="display-4">
        <span>@Model.Data.Name (@Model.Data.Hex),</span>
        <a href="@Url.Page("/subsector", new { milieu = Model.Sector.Milieu, sector = Model.Sector.DefaultName, subsector = Model.Subsector.Name })">@Model.Subsector.Name (Subsector @Model.Subsector.Code)</a>,
        <a href="@Url.Page("/sector", new { milieu = Model.Sector.Milieu, sector = Model.Sector.DefaultName })">@Model.Sector.DefaultName</a>
    </h3>
</div>

<form method="post">
    <div class="float-right" style="margin-left: 10px">
        <div class="text-right">
            @if (Model.TravelZone.Code == "A")
            {
                <label class="alert alert-warning">Advisory: Amber Zone</label>
            }
            else if (Model.TravelZone.Code == "R")
            {
                <label class="alert alert-danger">Advisory: Red Zone</label>
            }
            else if (Model.TravelZone.Code == "B")
            {
                <label class="alert alert-info">Advisory: Balkanized</label>
            }
            else if (Model.TravelZone.Code == "W")
            {
                <label class="alert alert-warning">Advisory: Wilds</label>
            }

            @if (!String.IsNullOrEmpty(Model.Bases.Code))
            {
                <label class="alert alert-info">@Model.Bases.ShortText</label>
            }
        </div>
        <div>
            <img src="/api/Images/@Model.Data.Id" style="cursor: pointer" onclick="SectorImageClick(event)" />
        </div>
    </div>

    <div>
        <table class="table table-sm">
            <tr>
                <td class="display-4 text-muted">UWP</td>
                <td colspan="2" class="text-primary display-4">@Model.Data.UWP</td>
            </tr>

            <tr>
                <td>Starport</td>
                <td class="text-muted no-wrap">@Model.Starport.Code</td>
                <td>
                    <div>@Model.Starport.ShortText</div>
                    <div class="text-muted">@Model.Starport.LongText</div>
                </td>
            </tr>

            <tr>
                <td>Planet Size</td>
                <td class="text-muted no-wrap">@Model.PlanetSize.Code</td>
                <td>
                    <div>@Model.PlanetSize.ShortText</div>
                    <div class="text-muted">@Model.PlanetSize.LongText</div>
                </td>
            </tr>
            @if (!String.IsNullOrEmpty(Model.Gravity.Code))
            {
                <tr>
                    <td>Gravity</td>
                    <td class="text-muted no-wrap">@Model.Gravity.Code</td>
                    <td>
                        <div>@Model.Gravity.ShortText</div>
                        <div class="text-muted">@Model.Gravity.LongText</div>
                    </td>
                </tr>
            }
            <tr>
                <td>Atmosphere</td>
                <td class="text-muted no-wrap">@Model.Atmosphere.Code</td>
                <td>
                    <div>@Model.Atmosphere.ShortText</div>
                    <div class="text-muted">@Model.Atmosphere.LongText</div>
                </td>
            </tr>


            <tr>
                <td>Hydrosphere</td>
                <td class="text-muted no-wrap">@Model.Hydrosphere.Code</td>
                <td>
                    <div>@Model.Hydrosphere.ShortText</div>
                    <div class="text-muted">@Model.Hydrosphere.LongText</div>
                </td>
            </tr>
            @if (!String.IsNullOrEmpty(Model.Climate.Code))
            {
                <tr>
                    <td>Climate</td>
                    <td class="text-muted no-wrap">@Model.Climate.Code</td>
                    <td>
                        <div>@Model.Climate.ShortText</div>
                        <div class="text-muted">@Model.Climate.LongText</div>
                    </td>
                </tr>
            }

            <tr>
                <td>Population</td>
                <td class="text-muted no-wrap">@Model.Population.Code</td>
                <td>
                    <div>@Model.Population.ShortText</div>
                    <div class="text-muted">@Model.Population.LongText</div>
                </td>
            </tr>

            <tr>
                <td>Government</td>
                <td class="text-muted no-wrap">@Model.Government.Code</td>
                <td>
                    <div>@Model.Government.ShortText</div>
                    <div class="text-muted">@Model.Government.LongText</div>
                </td>
            </tr>


            <tr>
                <td>Law Level</td>
                <td class="text-muted no-wrap">@Model.LawLevel.Code</td>
                <td>
                    <div>@Model.LawLevel.ShortText</div>
                    <div class="text-muted">@Model.LawLevel.LongText</div>
                </td>
            </tr>


            <tr>
                <td>Tech Level</td>
                <td class="text-muted no-wrap">@Model.TechLevel.Code</td>
                <td>
                    <div>@Model.TechLevel.ShortText</div>
                    <div class="text-muted">@Model.TechLevel.LongText</div>
                </td>
            </tr>


            <tr>
                <td>Importance</td>
                <td class="text-muted no-wrap">@Model.Importance.Code</td>
                <td>
                    <div>@Model.Importance.ShortText</div>
                    <div class="text-muted">@Model.Importance.LongText</div>
                </td>
            </tr>


            <tr>
                <td>Allegiance</td>
                <td class="text-muted no-wrap">@Model.Allegiance.Code</td>
                <td>
                    <div>@Model.Allegiance.ShortText</div>
                    <div class="text-muted">@Model.Allegiance.LongText</div>
                </td>
            </tr>

            <tr>
                <td>Trade Codes</td>
                <td class="text-muted no-wrap">@Model.TradeCodes.Code</td>
                <td>
                    <div>@Model.TradeCodes.ShortText</div>
                    <div class="text-muted">@Model.TradeCodes.LongText</div>
                </td>
            </tr>

            <tr>
                <td>Economics</td>
                <td class="text-muted no-wrap">@Model.Economics.Code</td>
                <td>
                    <div>@Model.Economics.ShortText</div>
                    <div class="text-muted">@Model.Economics.LongText</div>
                </td>
            </tr>


            <tr>
                <td>Culture</td>
                <td class="text-muted no-wrap">@Model.Culture.Code</td>
                <td>
                    <div>@Model.Culture.ShortText</div>
                    <div class="text-muted">@Model.Culture.LongText</div>
                </td>
            </tr>


            <tr>
                <td>Stars</td>
                <td class="text-muted no-wrap">@Model.Data.Stellar</td>
                <td>
                    @if (Model.Stellar.Stars.Count == 0)
                    {
                        <div>@Model.Stellar.StellarDescription</div>
                    }
                    else
                    {
                        <div>@Model.Stellar.Configuration star system</div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mt-1 mb-1">
                                <thead>
                                    <tr class="text-muted">
                                        <th>Star</th>
                                        <th>Type</th>
                                        <th class="text-right">Temp (K)</th>
                                        <th class="text-right">Radius (Sun = 1)</th>
                                        <th class="text-right">Mass (Sun = 1)</th>
                                        <th class="text-right">Luminosity (Sun = 1)</th>
                                        <th class="text-right">Habitable Zone (AU)</th>
                                        <th class="text-right">Jump Shadow</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var star in Model.Stellar.Stars)
                                    {
                                        <tr>
                                            <td class="no-wrap">@star.Role<br /><span class="text-muted">@star.Code</span></td>
                                            <td>@star.CommonName<br /><span class="text-muted">@star.ClassName</span></td>
                                            <td class="text-right">@star.Temperature.ToString("n0")</td>
                                            <td class="text-right">@StellarDataFactory.FormatValue(star.Radius)<br /><span class="text-muted">@StellarDataFactory.FormatDistance(star.RadiusKm, false)</span></td>
                                            <td class="text-right">@StellarDataFactory.FormatValue(star.Mass)</td>
                                            <td class="text-right">@StellarDataFactory.FormatValue(star.Luminosity)</td>
                                            <td class="text-right no-wrap">@StellarDataFactory.FormatAU(star.InnerHZ) - @StellarDataFactory.FormatAU(star.OuterHZ)</td>
                                            <td class="text-right">@StellarDataFactory.FormatDistance(star.JumpShadowKm)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @foreach (var star in Model.Stellar.Stars)
                        {
                            <div><span class="text-muted">@star.Role (@star.Code):</span> @star.Notes</div>
                        }
                        <div class="mt-1">@Model.Stellar.HabitableZoneDescription</div>
                        <div>@Model.Stellar.OrbitalPeriod</div>
                        @if (Model.Stellar.TidalLockingDescription != null)
                        {
                            <div>@Model.Stellar.TidalLockingDescription</div>
                        }
                    }
                </td>
            </tr>
            <tr>
                <td>Safe Jump</td>
                <td class="text-muted no-wrap">@StellarDataFactory.FormatDistance(Model.Stellar.SafeJumpDistanceKm, false)</td>
                <td>
                    @if (Model.Stellar.SafeJumpWarning != null)
                    {
                        <div class="alert alert-danger mb-1">@Model.Stellar.SafeJumpWarning</div>
                    }
                    <div class="text-muted">@Model.Stellar.SafeJumpDescription</div>
                    <table class="table table-sm table-bordered mt-1 mb-1" style="width: auto">
                        <thead>
                            <tr class="text-muted">
                                <th>Acceleration</th>
                                <th>Time (accelerate / decelerate)</th>
                                <th>Time (constant acceleration)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var jump in Model.Stellar.SafeJumpTimes)
                            {
                                <tr>
                                    <td>@(jump.Acceleration)G</td>
                                    <td>@jump.TimeText</td>
                                    <td>@jump.TimeNoTurnoverText</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-muted small">Accelerate / decelerate uses the standard Traveller formula T = 2&radic;(D/A), arriving at rest. Constant acceleration (no turnover) uses T = &radic;(2D/A).</div>
                </td>
            </tr>
            @if (!String.IsNullOrEmpty(Model.Orbit.Code))
            {
                <tr>
                    <td>Orbit</td>
                    <td class="text-muted no-wrap">@Model.Orbit.Code</td>
                    <td>@Model.Orbit.ShortText</td>
                </tr>
            }
            <tr>
                <td>System Details</td>
                <td class="text-muted no-wrap">@Model.System.Code</td>
                <td>@Model.System.ShortText</td>
            </tr>
        </table>
    </div>
</form>
<div style="clear:both"></div>

<script type="text/javascript">
    function SectorImageClick(e) {
        // Given the size of the image, determine which hex the user clicked.
        // The image has a margin around it which must be ignored
        // The hexes may be vertically offset depending on whether this is an even or odd numbered subsector
        // Image is 505x560 pixels (at 64px/pc)
        // There is a 12px margin-x and margin-y
        // Hexes 64px high, with a spacing of 56px

        var clickx = e.offsetX - 12; // Hit Test origin is at the center of the image
        var hexx = Math.trunc(clickx / 56);

        var clicky = e.offsetY - 12; // Hit Test origin is at the center of the image
        if ((Math.abs(hexx) % 2) == 1) {
            // Adjust by half the height of the hex
            if ((Math.trunc(Number(@Model.Data.Hex) / 100) % 2) == 1)
                clicky -= 32;
            else
                clicky += 32;
        }

        var hexy = Math.trunc(clicky / 64);

        // Using this system's HexNumber as the origin, determine the X and Y offset
        hexx += Math.trunc(Number(@Model.Data.Hex) / 100) - 4;
        hexy += Math.trunc(Number(@Model.Data.Hex) % 100) - 4;

        var hex = ("00" + hexx).slice(-2) + ("00" + hexy).slice(-2);
        console.log("Hex Clicked", hex, "at", clickx, ",", clicky);

        document.location.assign("/@Model.Sector.Milieu/@Model.Sector.DefaultName/@Model.Subsector.Name/" + hex);
    }
</script>
