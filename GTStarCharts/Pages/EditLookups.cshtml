@page "{handler?}"
@model GTStarCharts.Pages.EditLookupsModel
@{
    ViewData["Title"] = "Lookup Values";
}

<div>
    <h3 class="display-4">Lookup Values</h3>
    <form method="post" asp-page-handler="TextType">
        <div class="row">
            <div class="col-md-6 form-group">
                <label>Lookup Category</label>
                <div class="input-group">
                    <select class="form-control" asp-for="LookupType">
                        @foreach (var key in Model.LookupTypes.Keys)
                        {
                            <option value="@key">@Model.LookupTypes[key]</option>
                        }
                    </select>
                    <button class="input-group-addon btn btn-primary">Select</button>
                </div>
            </div>
        </div>
    </form>
</div>


@if (Model.LookupType != GTStarData.TextType.Unknown)
{
    <form method="post" asp-page-handler="AddValue">
        <input type="hidden" asp-for="LookupType" value="@Model.LookupType" />
        <h3 class="display-4">Add / Update Value for @Model.LookupTypes[Model.LookupType]</h3>
        <div class="row">
            <div class="col-md-1 form-group">
                <label>Code</label>
                <input class="form-control" asp-for="NewCode" />
            </div>
            <div class="col-md-5 form-group">
                <label>Short Description</label>
                <input class="form-control" asp-for="NewShortDescription" />
            </div>
            <div class="col-md-6 form-group">
                <label>Long Description</label>
                <input class="form-control" asp-for="NewLongDescription" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <button class="btn btn-primary">Add Value</button>
            </div>
        </div>
    </form>
}

@if (Model.Values != null)
{
    <div>
        <table class="table table-striped table-sm">
            <tr>
                <th>Code</th>
                <th>Short Description</th>
                <th>Long Description</th>
            </tr>

            @foreach (var value in Model.Values)
            {
                <tr>
                    <td>@value.Code</td>
                    <td>@value.ShortText</td>
                    <td>@value.LongText</td>
                </tr>
            }
        </table>
    </div>
}
