    public enum Endian
    {
        Default,
        Little,
        Big,
        Reverse
    }

    public static class Extensions
    {
        public static object[] ToIListArray(this IList list)
        {
            List<object> result = new List<object>();
            foreach (var obj in list)
                result.Add(obj);
            return result.ToArray();
        }

        public static void Sort<T>(this IList<T> list, Comparer<T> comparer)
            where T : class
        {
            SortItems(list, (a, b) => comparer.Compare(a, b));
        }

        public static void Sort<T>(this IList<T> list, Func<T, T, int> comparer)
            where T : class
        {
            SortItems(list, (a, b) => comparer(a, b));
        }

        private static void SortItems<T>(IList<T> list, Func<T, T, int> comparer)
            where T : class
        {
            List<T> sorted = new List<T>(list);
            sorted.Sort((a, b) => comparer(a, b));

            for (int i = 0; i < sorted.Count; i++)
            {
                if (list[i] != sorted[i])
                {
                    // Note that this results in a 2*O(n) cost of operation. This will have an impact of 
                    // very large lists (over 1000 items). However, if the original list is already sorted,
                    // then there is no impact.
                    list.Remove(sorted[i]);
                    list.Insert(i, sorted[i]);
                }
            }
        }

        private static void Window_Deactivated(object sender, EventArgs e)
        {
            (sender as Window)?.Activate();
            (sender as Window)?.Focus();
        }

        public static DateTime? ToLocalDateTime(this DateTimeOffset? date)
        {
            if (date == null) return null;
            return date.Value.LocalDateTime;
        }

        public static DateTime ToLocalDateTime(this DateTimeOffset date)
        {
            return date.LocalDateTime;
        }

        public static DateTime Truncate(this DateTime time, TimeSpan period)
        {
            // Truncates to the specified time period. Eg, 30 minutes to truncate to the current half-hour
            double min = Math.Truncate(time.TimeOfDay.TotalSeconds / period.TotalSeconds) * period.TotalSeconds;
            return time.Date.AddSeconds(min);
        }

        public static DateTime WeekStart(this DateTime time, DayOfWeek firstDayOfWeek = DayOfWeek.Monday)
        {
            while (time.DayOfWeek != firstDayOfWeek)
                time = time.AddDays(-1);

            return time;
        }

        public static DateTime MonthStart(this DateTime time)
        {
            return new DateTime(time.Year, time.Month, 1);
        }

        public static DateTime QuarterStart(this DateTime time)
        {
            return new DateTime(time.Year, ((time.Month - 1) / 3) * 3 + 1, 1);
        }

        public static DateTime YearStart(this DateTime time)
        {
            return new DateTime(time.Year, 1, 1);
        }

        public static string Truncate(this string text, int maxlen)
        {
            if (String.IsNullOrEmpty(text)) return text;
            if (text.Length < maxlen) return text;
            return text.Substring(0, maxlen);
        }

        public static DateTime Ceiling(this DateTime time, TimeSpan period)
        {
            // Rounds up to the next time period.
            double ceiling = Math.Ceiling(time.TimeOfDay.TotalSeconds / period.TotalSeconds) * period.TotalSeconds;
            return time.Date.AddSeconds(ceiling);
        }

        public static int BinaryCompare<T>(this T[] items, Func<int, T, int> compare)
        {
            int min = 0;
            int max = items.Length - 1;
            while (min <= max)
            {
                int mid = (min + max) / 2;

                int equality = compare(mid, items[mid]);
                if (equality > 0)
                    min = mid + 1;
                else if (equality < 0)
                    max = mid - 1;
                else
                    return mid;
            }

            // Did not find a match based on the comparer
            return -1;
        }

        public static void LogException(this Exception ex, bool showDialog, Window owner = null)
        {
            try
            {
                Debug.WriteLine(ex.ToString());

                if (!EventLog.SourceExists("VIMonitorPlus"))
                    EventLog.CreateEventSource("VIMonitorPlus", "Application");

                EventLog.WriteEntry("VIMonitorPlus", ex.ToString(), EventLogEntryType.Error, 0);
            }
            catch (Exception _ex)
            {
                Debug.WriteLine("Unable to log exception: " + _ex.Message);
            }

            if (showDialog)
            {
                if (owner == null)
                    MessageBox.Show(ex.Message, Application.Current.Product(), MessageBoxButton.OK, MessageBoxImage.Error);
                else if (owner.Dispatcher.CheckAccess())
                    MessageBox.Show(owner, ex.Message, Application.Current.Product(), MessageBoxButton.OK, MessageBoxImage.Error);
                else
                    owner.Dispatcher.Invoke(() => MessageBox.Show(owner, ex.Message, Application.Current.Product(), MessageBoxButton.OK, MessageBoxImage.Error));
            }
        }

        static GraphicsPath RoundedRect(int x, int y, int width, int height, int radius)
        {
            int diameter = radius * 2;
            var arc = new Rectangle(x, y, diameter, diameter);
            GraphicsPath path = new GraphicsPath();

            if (radius == 0)
            {
                path.AddRectangle(new Rectangle(x, y, width, height));
                return path;
            }

            // top left arc  
            path.AddArc(arc, 180, 90);

            // top right arc  
            arc.X = x + width - diameter;
            path.AddArc(arc, 270, 90);

            // bottom right arc  
            arc.Y = y + height - diameter;
            path.AddArc(arc, 0, 90);

            // bottom left arc 
            arc.X = x;
            path.AddArc(arc, 90, 90);

            path.CloseFigure();
            return path;
        }

        public static void DrawRoundedRectangle(this Graphics graphics, Pen pen, Rectangle bounds, int cornerRadius)
        {
            if (graphics == null)
                throw new ArgumentNullException("graphics");
            if (pen == null)
                throw new ArgumentNullException("pen");

            using (GraphicsPath path = RoundedRect(bounds.X, bounds.Y, bounds.Width, bounds.Height, cornerRadius))
            {
                graphics.DrawPath(pen, path);
            }
        }

        public static void DrawRoundedRectangle(this Graphics graphics, Pen pen, int x, int y, int width, int height, int cornerRadius)
        {
            if (graphics == null)
                throw new ArgumentNullException("graphics");
            if (pen == null)
                throw new ArgumentNullException("pen");

            using (GraphicsPath path = RoundedRect(x, y, width, height, cornerRadius))
            {
                graphics.DrawPath(pen, path);
            }
        }

        public static void FillRoundedRectangle(this Graphics graphics, Brush brush, Rectangle bounds, int cornerRadius)
        {
            if (graphics == null)
                throw new ArgumentNullException("graphics");
            if (brush == null)
                throw new ArgumentNullException("brush");

            using (GraphicsPath path = RoundedRect(bounds.X, bounds.Y, bounds.Width, bounds.Height, cornerRadius))
            {
                graphics.FillPath(brush, path);
            }
        }

        public static void FillRoundedRectangle(this Graphics graphics, Brush brush, int x, int y, int width, int height, int cornerRadius)
        {
            if (graphics == null)
                throw new ArgumentNullException("graphics");
            if (brush == null)
                throw new ArgumentNullException("brush");

            using (GraphicsPath path = RoundedRect(x, y, width, height, cornerRadius))
            {
                graphics.FillPath(brush, path);
            }
        }

        public static void FillRoundedRectangle(this Graphics graphics, Brush brush, float x, float y, float width, float height, float cornerRadius)
        {
            if (graphics == null)
                throw new ArgumentNullException("graphics");
            if (brush == null)
                throw new ArgumentNullException("brush");

            using (GraphicsPath path = RoundedRect((int)x, (int)y, (int)width, (int)height, (int)cornerRadius))
            {
                graphics.FillPath(brush, path);
            }
        }

        public static IList<T> AppendTo<T>(this IEnumerable<T> source, IList<T> target)
        {
            foreach (var item in source)
                target.Add(item);
            return target;
        }

        public static void AddRange<T>(this BindingList<T> list, IEnumerable<T> items)
        {
            list.RaiseListChangedEvents = false;

            foreach (var item in items)
                list.Add(item);

            list.RaiseListChangedEvents = false;
        }

        public static T CopyInto<T>(this object source, T target, string propertyName = null)
        {
            if (source == null || target == null)
                return target;

            foreach (var sourceProp in GetProperties(source))
            {
                if (propertyName == null || sourceProp.Name == propertyName)
                {
                    var targetProp = GetProperty(target, sourceProp.Name);
                    if (targetProp != null && targetProp.CanWrite)
                    {
                        // allow copying of arrays, but not other types of IEnumerable
                        if (sourceProp.PropertyType.IsArray)
                        {
                            Type elementType = sourceProp.PropertyType.GetElementType();
                            if (elementType == typeof(string) || elementType.IsValueType)
                            {
                                // Elements can be safely copied
                                var value = (Array)sourceProp.GetValue(source);
                                if (value == null)
                                    targetProp.SetValue(target, null);
                                else
                                {
                                    var array = Array.CreateInstance(elementType, value.Length);
                                    value.CopyTo(array, 0);
                                    targetProp.SetValue(target, array);
                                }
                            }
                            else
                            {
                                // Do not copy arrays of class types
                                continue;
                            }
                        }
                        else if(sourceProp.PropertyType == typeof(string))
                        {
                            // Copy the string
                            targetProp.SetValue(target, sourceProp.GetValue(source));
                        }
                        else if (typeof(IEnumerable).IsAssignableFrom(sourceProp.PropertyType))
                        {
                            // Do not copy IEnumerable properties
                            continue;
                        }
                        else
                        {
                            // Allow nullable source properties to be assigned to non-nullable target properties
                            var value = sourceProp.GetValue(source);
                            if (sourceProp.PropertyType.IsGenericType && !targetProp.PropertyType.IsGenericType && sourceProp.PropertyType.GetGenericTypeDefinition() == typeof(Nullable<>))
                            {
                                if (value != null)
                                    targetProp.SetValue(target, value);
                            }
                            else if (targetProp.PropertyType.IsAssignableFrom(sourceProp.PropertyType))
                                targetProp.SetValue(target, value);
                        }
                    }
                }
            }
            return target;
        }

        static Dictionary<Type, Dictionary<string, PropertyInfo>> _propertyInfoCache = new Dictionary<Type, Dictionary<string, PropertyInfo>>();

        public static IEnumerable<PropertyInfo> GetProperties(object instance)
        {
            lock (_propertyInfoCache)
            {
                Type type = instance.GetType();
                if (_propertyInfoCache.TryGetValue(type, out Dictionary<string, PropertyInfo> props))
                    return props.Values;

                // Query property info and add to the cache
                props = type.GetProperties().ToDictionary(p => p.Name);
                _propertyInfoCache.Add(type, props);
                return props.Values;
            }
        }

        public static PropertyInfo GetProperty(object instance, string name)
        {
            if (instance == null)
                return null;

            lock (_propertyInfoCache)
            {
                Type type = instance.GetType();
                if (!_propertyInfoCache.ContainsKey(type))
                    GetProperties(instance);

                if (_propertyInfoCache.TryGetValue(type, out Dictionary<string, PropertyInfo> props))
                    if (props.TryGetValue(name, out PropertyInfo prop))
                        return prop;

                return null;
            }
        }

        public static T GetValue<T>(this object instance, string name, BindingFlags flags = BindingFlags.Instance)
        {
            var value = GetValue(instance, name, flags);
            if (value == null)
                return default(T);
            return (T)value;
        }

        public static object GetValue(this object instance, string name, BindingFlags flags = BindingFlags.Instance)
        {
            if (instance == null) return null;

            if (String.IsNullOrEmpty(name))
                return (object)instance.ToString();

            lock (_propertyInfoCache)
            {
                if (flags.HasFlag(BindingFlags.NonPublic))
                {
                    // Non-public properties are not cached - this may be slow
                    var prop = instance.GetType().GetProperty(name, flags);
                    if (prop != null)
                        return prop.GetValue(instance);

                    // Fields are not cached - this may be slow
                    var field = instance.GetType().GetField(name, flags);
                    if (field != null)
                        return field.GetValue(instance);
                }
                else
                {
                    // Public properties are cached - this will be fast
                    var prop = GetProperty(instance, name);
                    if (prop != null)
                        return prop.GetValue(instance);
                }
            }

            return null;
        }

        public static void SetValue<T>(this object instance, string name, T value, BindingFlags flags = BindingFlags.Instance)
        {
            if (instance == null) return;
            if (String.IsNullOrEmpty(name)) return;

            lock (_propertyInfoCache)
            {
                if (flags.HasFlag(BindingFlags.NonPublic))
                {
                    // Non-public properties are not cached - this may be slow
                    var prop = instance.GetType().GetProperty(name, flags);
                    if (prop != null)
                        prop.SetValue(instance, value);

                    // Fields are not cached - this may be slow
                    var field = instance.GetType().GetField(name, flags);
                    if (field != null)
                        field.SetValue(instance, value);
                }
                else
                {
                    // Public properties are cached - this will be fast
                    var prop = GetProperty(instance, name);
                    if (prop != null)
                        prop.SetValue(instance, value);
                }
            }
        }

        public static void UpdateValue(this RegistryKey key, string name, string value)
        {
            if (value == null)
                key.DeleteValue(name, false);
            else
                key.SetValue(name, value);
        }

        public static string[] ToColumnNameArray(this string text)
        {
            if (text == null) return null;

            List<string> names = new List<string>();
            int index = 0;
            while (index < text.Length && Char.IsWhiteSpace(text[index]))
                index++;

            while (index < text.Length)
            {
                if (text[index] == '[')
                {
                    // Scan to the closing ']'
                    index++;
                    int startindex = index;
                    while (index < text.Length && text[index] != ']')
                        index++;

                    names.Add(text.Substring(startindex, index - startindex));

                    // Skip past the closing bracket
                    index++;
                }
                else if (text[index] == '"')
                {
                    // Scan to the closing quote
                    index++;
                    int startindex = index;
                    while (index < text.Length && text[index] != '"')
                        index++;

                    names.Add(text.Substring(startindex, index - startindex));

                    // Skip past the closing quote
                    index++;
                }
                else
                {
                    // Scan to the end of string or non-alpha
                    int startindex = index;
                    while (index < text.Length && (text[index] == '_' || Char.IsLetterOrDigit(text[index])))
                        index++;

                    names.Add(text.Substring(startindex, index - startindex));
                }

                if (index < text.Length && text[index] == ',')
                {
                    // Skip comma, skip whitespace
                    index++;
                    while (index < text.Length && (Char.IsWhiteSpace(text[index]) || text[index] == ','))
                        index++;
                }
            }

            return names.ToArray();
        }

        public static byte[] HexToBytes(this string hex)
        {
            if (hex == null)
                throw new ArgumentNullException(nameof(hex));
            if ((hex.Length % 2) != 0)
                throw new ArgumentException("Hexadecimal string must have an even number of bytes", nameof(hex));

            byte[] result = new byte[hex.Length / 2];

            int len = hex.Length;
            int index = 0;
            for (int i = 0; i < len; i += 2)
            {
                int hi = hex[i] - 48;
                if (hi > 10) hi -= 7;
                if (hi > 10) hi -= 32;

                int lo = hex[i + 1] - 48;
                if (lo > 10) lo -= 7;
                if (lo > 10) lo -= 32;

                result[index] = (byte)((hi << 4) | lo);
                index++;
            }

            return result;
        }

        public static DateTime ReadBcdDateTime(this BinaryReader reader)
        {
            int y = reader.ReadBcdByte() + 2000;
            int mo = reader.ReadBcdByte();
            int d = reader.ReadBcdByte();
            int h = reader.ReadBcdByte();
            int mi = reader.ReadBcdByte();
            int s = reader.ReadBcdByte();

            try
            {
                if (y > 2000 && mo >= 1 && mo <= 12 && d >= 1 && d <= DateTime.DaysInMonth(y, mo) && h <= 23 && mi <= 59 && s <= 59)
                    return new DateTime(y, mo, d, h, mi, s);

                return DateTime.MinValue;
            }
            catch
            {
                return DateTime.MinValue;
            }
        }

        public static UInt16 ReadUInt16(this BinaryReader reader, Endian endian)
        {
            switch (endian)
            {
                case Endian.Little:
                    if (BitConverter.IsLittleEndian)
                        return reader.ReadUInt16();
                    break;

                case Endian.Big:
                    if (!BitConverter.IsLittleEndian)
                        return reader.ReadUInt16();
                    break;

                case Endian.Default:
                    return reader.ReadUInt16();
            }

            // Reverses the endianess
            int b1 = reader.ReadByte();
            int b2 = reader.ReadByte();
            return (UInt16)((b1 << 8) | b2);
        }

        public static byte ReadBcdByte(this BinaryReader reader)
        {
            // BCD: basically, 0x98 should be returned as Decimal 98
            int b = reader.ReadByte();
            return (byte)(((b >> 4) * 10) + (b & 0x0F));
        }

        public static string ReadIpAddress(this BinaryReader reader)
        {
            return $"{reader.ReadByte()}.{reader.ReadByte()}.{reader.ReadByte()}.{reader.ReadByte()}";
        }

        public static void AddParameter(this DbCommand cmd, string name, object value)
        {
            var p = cmd.CreateParameter();
            p.ParameterName = name;
            if (value == null)
                p.Value = DBNull.Value;
            else
                p.Value = value;
            cmd.Parameters.Add(p);
        }

        public static Type GetClrTypeFromCSpaceType(this MetadataWorkspace workspace, EntitySetMapping mapping)
        {
            return GetClrTypeFromCSpaceType(workspace, mapping.EntityTypeMappings.First().EntityType);
        }

        public static Type GetClrTypeFromCSpaceType(this MetadataWorkspace workspace, EdmType cType)
        {
            var itemCollection = (ObjectItemCollection)workspace.GetItemCollection(DataSpace.OSpace);

            if (cType is StructuralType)
            {
                var osType = workspace.GetObjectSpaceType((StructuralType)cType);
                return itemCollection.GetClrType(osType);
            }
            else if (cType is EnumType)
            {
                var osType = workspace.GetObjectSpaceType((EnumType)cType);
                return itemCollection.GetClrType(osType);
            }
            else if (cType is PrimitiveType)
            {
                return ((PrimitiveType)cType).ClrEquivalentType;
            }
            else if (cType is CollectionType)
            {
                return workspace.GetClrTypeFromCSpaceType(((CollectionType)cType).TypeUsage.EdmType);
            }
            else if (cType is RefType)
            {
                return workspace.GetClrTypeFromCSpaceType(((RefType)cType).ElementType);
            }
            else if (cType is EdmFunction)
            {
                return workspace.GetClrTypeFromCSpaceType(((EdmFunction)cType).ReturnParameter.TypeUsage.EdmType);
            }

            return null;
        }
    }
}
