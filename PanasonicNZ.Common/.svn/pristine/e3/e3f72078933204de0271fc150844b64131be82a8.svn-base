using PanasonicNZ.Common;
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Drawing;
using System.IO;
using System.Runtime.InteropServices;
using System.Threading;
using System.Threading.Tasks;
using System.Windows.Controls;
using System.Windows.Controls.Primitives;
using System.Windows.Data;
using System.Windows.Input;
using System.Windows.Markup;
using System.Windows.Media;
using System.Windows.Media.Imaging;

namespace System.Windows
{
    public class WpfAutoCompleteOptions
    {
        public Popup Popup { get; set; }
        public ListBox ListBox { get; set; }
        public Func<string, List<object>> FilterAction { get; set; }
        public Func<string, CancellationToken, Task<List<object>>> FilterActionAsync { get; set; }
        public Action<TextBox, object> OnSelected { get; set; }
        public int MinimumLength { get; set; } = 1;
        public int Delay { get; set; }
        public int MaxHeight { get; set; } = 300;
        public bool SelectAndExitOnEnterKey { get; set; }
        public string DisplayMemberPath { get; set; }
        public Media.Brush Background { get; set; }
    }

    public static class WpfExtensions
    {
        static int AutoCompleteId = 0;

        public static void AutoComplete(this TextBox textbox, Action<WpfAutoCompleteOptions> config)
        {
            if (config == null) throw new ArgumentNullException("Config action must be provided for WPF AutoComplete");

            WpfAutoCompleteOptions options = new WpfAutoCompleteOptions();
            config.Invoke(options);

            textbox.AcceptsReturn = true;
            textbox.TextWrapping = TextWrapping.NoWrap;
            string previoustext = textbox.Text;

            CancellationTokenSource cancellationSource = new CancellationTokenSource();

            if (options.Popup == null)
            {
                CreatePopup(textbox, options);
            }

            textbox.LostFocus += (obj, args) =>
            {
                var selected = options.ListBox.SelectedItem;
                if (options.Popup.IsOpen)
                {
                    options.ListBox.Items.Clear();
                    options.Popup.IsOpen = false;
                }
            };

            void ShowFilterResults(List<object> items)
            {
                var selectedItem = options.ListBox.SelectedItem;
                options.ListBox.Items.Clear();
                foreach (var item in items)
                {
                    options.ListBox.Items.Add(item);
                    if (selectedItem != null && selectedItem.Equals(item))
                        options.ListBox.SelectedItem = item;
                }

                options.Popup.IsOpen = items.Count > 0;
            }

            void StartAutoCompletion(int delay)
            {
                previoustext = textbox.Text;
                if (textbox.Text.Length < options.MinimumLength)
                {
                    options.ListBox.Items.Clear();
                    options.Popup.IsOpen = false;
                }
                else
                {
                    // Cancel any pending filtering
                    cancellationSource.Cancel();

                    // Start a new pending filter
                    cancellationSource = new CancellationTokenSource();
                    var mytoken = cancellationSource.Token;
                    var myterm = textbox.Text;

                    Task.Delay(delay, mytoken)
                        .ContinueWith(async task =>
                        {
                            // Fetch the results using the Async method if available, otherwise do it synchronously
                            List<object> result = null;
                            if (options.FilterActionAsync != null)
                                result = await options.FilterActionAsync(myterm, mytoken);
                            else if (options.FilterAction != null)
                                result = options.FilterAction(myterm);

                            if (!mytoken.IsCancellationRequested)
                            {
                                // Display the results on the main thread
                                options.ListBox.Dispatcher.Invoke(() =>
                                {
                                    ShowFilterResults(result);
                                }, System.Windows.Threading.DispatcherPriority.Normal, mytoken);
                            }
                        }, mytoken, TaskContinuationOptions.NotOnCanceled | TaskContinuationOptions.NotOnFaulted, TaskScheduler.Default);
                }
            };

            textbox.KeyDown += (obj, args) =>
            {
                switch (args.Key)
                {
                    case Key.Enter:
                        args.Handled = true;
                        break;

                    case Key.Escape:
                        args.Handled = true;
                        break;
                }
            };

            textbox.PreviewKeyDown += (obj, args) =>
            {
                switch (args.Key)
                {
                    case Key.Escape:
                        if (options.Popup.IsOpen)
                        {
                            options.ListBox.Items.Clear();
                            options.Popup.IsOpen = false;
                            args.Handled = true;
                        }
                        textbox.Text = "";
                        break;

                    case Key.Down:
                    case Key.Up:
                        if (options.Popup.IsOpen)
                            args.Handled = true;
                        break;

                    case Key.Enter:
                        if (options.Popup.IsOpen)
                        {
                            if (options.ListBox.SelectedItem == null)
                            {
                                if (options.ListBox.Items.Count > 0)
                                {
                                    // Select first one
                                    var selected = options.ListBox.Items[0];
                                    textbox.Text = selected.GetValue<string>(options.DisplayMemberPath);
                                    textbox.SelectAll();
                                    options.OnSelected?.Invoke(textbox, selected);
                                }
                            }
                            else
                            {
                                // Select the highlighted item
                                var selected = options.ListBox.SelectedItem;
                                textbox.Text = selected.GetValue<string>(options.DisplayMemberPath);
                                textbox.SelectAll();
                                options.OnSelected?.Invoke(textbox, selected);
                            }
                            options.Popup.IsOpen = false;
                        }
                        args.Handled = true;
                        break;
                }
            };

            textbox.KeyUp += (obj, args) =>
            {
                switch (args.Key)
                {
                    case Key.Escape:
                        args.Handled = true;
                        break;

                    case Key.Up:
                        if (options.Popup.IsOpen)
                        {
                            if (options.ListBox.SelectedIndex >= 0)
                                options.ListBox.SelectedIndex = options.ListBox.SelectedIndex - 1;
                        }
                        args.Handled = true;
                        break;

                    case Key.Down:
                        if (options.Popup.IsOpen)
                        {
                            if (options.ListBox.SelectedIndex < options.ListBox.Items.Count)
                                options.ListBox.SelectedIndex = options.ListBox.SelectedIndex + 1;
                        }
                        else
                            StartAutoCompletion(0);

                        args.Handled = true;
                        break;

                    case Key.Enter:
                        if (options.Popup.IsOpen)
                        {
                            options.Popup.IsOpen = false;
                            if (options.SelectAndExitOnEnterKey)
                                textbox.MoveFocus(new TraversalRequest(FocusNavigationDirection.Next));
                        }
                        args.Handled = true;
                        break;

                    default:
                        if (!options.Popup.IsOpen || previoustext != textbox.Text)
                            StartAutoCompletion(options.Delay);
                        break;
                }
            };

            options.Popup.PreviewMouseDown += (obj, args) =>
            {
                var container = VisualTreeHelper.HitTest(options.ListBox, args.GetPosition(options.ListBox));
                if (container.VisualHit is TextBlock tblk)
                {
                    // Find the label that owns the textblock
                    var parent = VisualTreeHelper.GetParent(tblk);
                    while (parent != null && !(parent is Label))
                        parent = VisualTreeHelper.GetParent(parent);

                    if (parent == null)
                    {
                        textbox.Text = tblk.DataContext.ToString();
                    }
                    else
                    {
                        options.ListBox.SelectedItem = ((Label)parent).DataContext;
                        if (options.OnSelected == null)
                            textbox.Text = tblk.DataContext.GetValue<string>(options.DisplayMemberPath);
                        else
                            options.OnSelected.Invoke(textbox, ((Label)parent).DataContext);
                    }
                    options.Popup.IsOpen = false;
                    args.Handled = true;
                }
            };
        }

        public static bool IsAlphaKey(this KeyEventArgs args)
        {
            return args.Key >= Key.A && args.Key <= Key.Z;
        }

        public static bool IsNumericKey(this KeyEventArgs args)
        {
            return (args.Key >= Key.D0 && args.Key <= Key.D9) || (args.Key >= Key.NumPad0 && args.Key <= Key.NumPad9);
        }

        public static bool IsAlphaNumericKey(this KeyEventArgs args)
        {
            return IsAlphaKey(args) || IsNumericKey(args);
        }

        private static void CreatePopup(TextBox textbox, WpfAutoCompleteOptions options)
        {
            //<Popup Name="PopupAutoComplete" Placement="Bottom" PlacementTarget="{Binding ElementName=<TargetControl>}" >
            //    <Grid>
            //        <ListBox Name="ListAutoComplete" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}">
            //            <ListBox.ItemTemplate>
            //                <DataTemplate>
            //                    <Label Content="{Binding}" Padding="6,4"></Label>
            //                </DataTemplate>
            //            </ListBox.ItemTemplate>
            //        </ListBox>
            //    </Grid>
            //</Popup>

            if (String.IsNullOrEmpty(textbox.Name))
                textbox.Name = "AutoCompleteTextBox_" + (++AutoCompleteId);

            // Create the Popup window
            Popup popup = new Popup();
            popup.Placement = PlacementMode.Bottom;

            Binding binding = new Binding();
            binding.ElementName = textbox.Name;
            popup.SetBinding(Popup.PlacementTargetProperty, binding);

            // Create a Grid and attach it to the Popup
            Grid grid = new Grid();
            popup.Child = grid;

            // Create a ListBox and add it to the Grid
            ListBox listbox = new ListBox();
            listbox.MaxHeight = options.MaxHeight;
            listbox.BorderThickness = new Thickness(1);
            listbox.Background = options.Background ?? SystemColors.ControlDarkDarkBrush;

            var resource = textbox.TryFindResource("AutoCompleteItem");
            if(resource is Style style && style.TargetType == typeof(ListBoxItem))
                listbox.ItemContainerStyle = style;

            grid.Children.Add(listbox);
            ScrollViewer.SetVerticalScrollBarVisibility(listbox, ScrollBarVisibility.Auto);
            ScrollViewer.SetHorizontalScrollBarVisibility(listbox, ScrollBarVisibility.Disabled);

            // Now create a DataTemplate
            var lblfactory = new FrameworkElementFactory(typeof(Label));
            lblfactory.SetValue(Label.ContentProperty, new Binding(options.DisplayMemberPath ?? "."));
            lblfactory.SetValue(Label.PaddingProperty, new Thickness(6, 4, 6, 4));

            DataTemplate template = new DataTemplate();
            template.VisualTree = lblfactory;
            listbox.ItemTemplate = template;

            if (textbox.Parent is IAddChild parent)
            {
                parent.AddChild(popup);
                options.Popup = popup;
                options.ListBox = listbox;
            }
        }

        public static void AddRange<T>(this ObservableCollection<T> collection, IEnumerable<T> items)
        {
            foreach (var item in items)
                collection.Add(item);
        }

        public static string ToLongString(this TimeSpan ts)
        {
            if (ts.TotalDays > 1)
                return $"{ts.Days} days, {ts.Hours} hours";

            if (ts.TotalHours > 1)
                return $"{ts.Hours} hours, {ts.Minutes} min";

            if (ts.TotalMinutes > 1)
                return $"{ts.Minutes} min, {ts.Seconds} sec";

            return $"{ts.Seconds} seconds";
        }

        public static Bitmap ControlToImage(this Visual target, double dpiX, double dpiY)
        {
            if (target == null)
            {
                return null;
            }
            // render control content
            Rect bounds = VisualTreeHelper.GetDescendantBounds(target);
            RenderTargetBitmap rtb = new RenderTargetBitmap((int)(bounds.Width * dpiX / 96.0),
                                                            (int)(bounds.Height * dpiY / 96.0),
                                                            dpiX,
                                                            dpiY,
                                                            PixelFormats.Pbgra32);
            DrawingVisual dv = new DrawingVisual();
            using (DrawingContext ctx = dv.RenderOpen())
            {
                VisualBrush vb = new VisualBrush(target);
                ctx.DrawRectangle(Media.Brushes.White, null, new Rect(new Point(), bounds.Size));
                ctx.DrawRectangle(vb, null, new Rect(new Point(), bounds.Size));
            }
            rtb.Render(dv);

            //convert image format
            MemoryStream stream = new MemoryStream();
            PngBitmapEncoder encoder = new PngBitmapEncoder();
            encoder.Interlace = PngInterlaceOption.Off;
            encoder.Frames.Add(BitmapFrame.Create(rtb));
            encoder.Save(stream);

            return new System.Drawing.Bitmap(stream);
        }

        public static bool IsKey(this KeyEventArgs e, ModifierKeys modifier, Key key)
        {
            return (e.Key == key && e.KeyboardDevice.Modifiers == ModifierKeys.None);
        }

    }

    namespace Media
    {
        public static class WpfExtensions
        {
            [DllImport("gdi32.dll", EntryPoint = "DeleteObject")]
            [return: MarshalAs(UnmanagedType.Bool)]
            static extern bool DeleteObject([In] IntPtr hObject);

            public static ImageSource CreateImageSource(this System.Drawing.Image bmp)
            {
                if (bmp == null)
                    return null;

                var handle = (bmp as Bitmap).GetHbitmap();
                try
                {
                    ImageSource newSource = Interop.Imaging.CreateBitmapSourceFromHBitmap(handle, IntPtr.Zero, Int32Rect.Empty, BitmapSizeOptions.FromEmptyOptions());

                    DeleteObject(handle);
                    return newSource;
                }
                catch
                {
                    DeleteObject(handle);
                    return null;
                }
            }

            public static Bitmap ImageFromImageData(byte[] arr, int width, int height, System.Drawing.Imaging.PixelFormat pixelFormat, bool flipY, Bitmap output)
            {
                if(output == null || output.Width != width || output.Height != height || output.PixelFormat != pixelFormat)
                {
                    output?.Dispose();
                    output = new Bitmap(width, height, pixelFormat);
                }

                var rect = new Rectangle(0, 0, width, height);
                var bmpData = output.LockBits(rect, System.Drawing.Imaging.ImageLockMode.ReadWrite, output.PixelFormat);

                // Row-by-row copy
                var arrRowLength = width * Bitmap.GetPixelFormatSize(output.PixelFormat) / 8;
                var ptr = bmpData.Scan0;
                if (flipY)
                {
                    for (var i = height - 1; i >= 0; i--)
                    {
                        Marshal.Copy(arr, i * arrRowLength, ptr, arrRowLength);
                        ptr += bmpData.Stride;
                    }
                }
                else
                {
                    for (var i = 0; i < height; i++)
                    {
                        Marshal.Copy(arr, i * arrRowLength, ptr, arrRowLength);
                        ptr += bmpData.Stride;
                    }
                }

                output.UnlockBits(bmpData);
                return output;
            }


        }
    }
}
