<Window x:Class="PanasonicNZ.WPF.FileProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PanasonicNZ.WPF"
        mc:Ignorable="d"
        Title="File Progress" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" Background="#1c1c1c">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PanasonicNZ.WPF;component/Styles/Flat.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.LayoutTransform>
        <ScaleTransform ScaleX="{Binding ScreenScale}" ScaleY="{Binding ScreenScale}"></ScaleTransform>
    </Window.LayoutTransform>
    <StackPanel Width="450">
        <StackPanel Margin="20,10">
            <WrapPanel Margin="1">
                <TextBlock Foreground="{StaticResource IdealForegroundColorBrush}" Margin="0,0,4,0" Text="{Binding Actioning}"></TextBlock>
                <TextBlock Foreground="{StaticResource IdealForegroundColorBrush}" Margin="0,0,4,0" Text="{Binding TotalItemCount}"></TextBlock>
                <TextBlock Foreground="{StaticResource IdealForegroundColorBrush}" Margin="0,0,4,0" Text="{Binding ItemsFrom}"></TextBlock>
                <TextBlock Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,4,0" Text="{Binding SourceFolderName}"></TextBlock>
                <TextBlock Foreground="{StaticResource IdealForegroundColorBrush}" Margin="0,0,4,0" Text="{Binding ItemsTo}"></TextBlock>
                <TextBlock Foreground="{StaticResource AccentTextBrush}" Margin="0,0,4,0" Text="{Binding TargetFolderName}"></TextBlock>
            </WrapPanel>
            <Label Padding="1,6" FontSize="18px" Content="{Binding PercentComplete}"></Label>
            <Label Padding="1" Content="{Binding SourceFileName}"></Label>
            <Label Padding="1" Content="{Binding TimeRemaining}"></Label>
            <Label Padding="1" Content="{Binding ItemsRemaining}"></Label>
            <ProgressBar Height="20" Margin="0,16,0,8" Value="{Binding Percent}"></ProgressBar>
        </StackPanel>
        <Border BorderThickness="0,1,0,0" BorderBrush="Silver">
            <WrapPanel HorizontalAlignment="Right" Margin="8">
                <Button MinWidth="75" Padding="8,3" Margin="8,0,0,0" Click="Pause_Click" Content="{Binding PauseOrResume}"></Button>
                <Button MinWidth="75" Padding="8,3" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click">Cancel</Button>
            </WrapPanel>
        </Border>
    </StackPanel>
</Window>
