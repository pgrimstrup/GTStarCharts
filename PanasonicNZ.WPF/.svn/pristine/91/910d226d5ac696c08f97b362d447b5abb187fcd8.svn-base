<Window x:Class="PanasonicNZ.WPF.MessageBoxWpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PanasonicNZ.WPF"
        mc:Ignorable="d" Background="{DynamicResource Background}" Icon="{x:Null}"
        Title="Alert" ShowInTaskbar="False" MinWidth="300" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PanasonicNZ.WPF;component/Styles/Flat.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Image Width="48" Height="48" Margin="10" Name="InformationIcon" Source="Resources/info.png" Visibility="Collapsed" VerticalAlignment="Top"></Image>
            <Image Width="48" Height="48" Margin="10" Name="QuestionIcon" Source="Resources/question.png" Visibility="Collapsed" VerticalAlignment="Top"></Image>
            <Image Width="48" Height="48" Margin="10" Name="WarningIcon" Source="Resources/warning.png" Visibility="Collapsed" VerticalAlignment="Top"></Image>
            <Image Width="48" Height="48" Margin="10" Name="ErrorIcon" Source="Resources/error.png" Visibility="Collapsed" VerticalAlignment="Top"></Image>
            <TextBlock MaxWidth="500" Margin="10,20" TextWrapping="WrapWithOverflow" Name="MessageText">Message Text goes here</TextBlock>
        </StackPanel>
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AccentColorBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                <Button MinWidth="75" Margin="6" Name="Button1" Click="Button1_Click">Button 1</Button>
                <Button MinWidth="75" Margin="6" Name="Button2" Click="Button2_Click">Button 2</Button>
                <Button MinWidth="75" Margin="6" Name="Button3" Click="Button3_Click">Button 3</Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
