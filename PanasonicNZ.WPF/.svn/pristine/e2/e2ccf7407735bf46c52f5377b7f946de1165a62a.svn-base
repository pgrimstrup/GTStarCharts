<Window x:Class="PanasonicNZ.WPF.FileProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PanasonicNZ.WPF"
        mc:Ignorable="d"
        Title="File Progress" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" Background="#1c1c1c">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PanasonicNZ.WPF;component/Styles/Flat.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.LayoutTransform>
        <ScaleTransform ScaleX="{Binding ScreenScale}" ScaleY="{Binding ScreenScale}"></ScaleTransform>
    </Window.LayoutTransform>
    <StackPanel Width="450">
        <StackPanel Margin="20,10">
            <Label Padding="1">
                <Label.Content>
                    <TextBlock TextWrapping="Wrap">
                        <TextBlock.Inlines>
                            <Run Text="{Binding Actioning}"></Run>
                            <Run Text="{Binding TotalItemCount}"></Run>
                            <Run Text="{Binding ItemsFrom}"></Run>
                            <Run Text="{Binding SourceFolderName}" Foreground="{StaticResource AccentTextBrush}"></Run>
                            <Run Text="{Binding ItemsTo}"></Run>
                            <Run Text="{Binding TargetFolderName}" Foreground="{StaticResource AccentTextBrush}"></Run>
                        </TextBlock.Inlines>
                    </TextBlock>
                </Label.Content>
            </Label>
            <Label Padding="1,6" FontSize="18px" Content="{Binding PercentComplete}"></Label>
            <Label Padding="1" Content="{Binding SourceFileName}"></Label>
            <Label Padding="1" Content="{Binding TimeRemaining}"></Label>
            <Label Padding="1" Content="{Binding ItemsRemaining}"></Label>
            <ProgressBar Height="20" Margin="0,16,0,8" Value="{Binding Percent}"></ProgressBar>
        </StackPanel>
        <Border BorderThickness="0,1,0,0" BorderBrush="Silver">
            <WrapPanel HorizontalAlignment="Right" Margin="8">
                <Button Margin="8,1,1,1" Click="Pause_Click" Content="{Binding PauseOrResume}"></Button>
                <Button Margin="8,1,1,1" IsCancel="True" Click="Cancel_Click">Cancel</Button>
            </WrapPanel>
        </Border>
    </StackPanel>
</Window>
