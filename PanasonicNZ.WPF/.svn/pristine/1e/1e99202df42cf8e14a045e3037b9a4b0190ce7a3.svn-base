<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/Orange.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/BaseDark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="StatusOpenBrush" Color="#FF006800"/>
    <SolidColorBrush x:Key="CategoryStandardBrush" Color="#FFE47D00"/>

    <SolidColorBrush x:Key="Background" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="LightBackground" Color="#2D2D30"/>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"></BooleanToVisibilityConverter>

    <Color x:Key="PrimaryBackground">#212120</Color>
    <Color x:Key="SecondaryBackground">#444445</Color>
    <Color x:Key="SecondaryHighlight">#929497</Color>
    <Color x:Key="TertiaryBackground">#737373</Color>
    <Color x:Key="TertiaryHighlight">#9F9F9F</Color>
    <Color x:Key="Urgent">#f04d2c</Color>
    <Color x:Key="UrgentHighlight">#f68b2c</Color>
    <Color x:Key="Important">#415FA2</Color>
    <Color x:Key="ImportantHighlight">#415FA2</Color>
    <Color x:Key="ControlBackground">#434343</Color>
    <Color x:Key="ControlHighlight">#737373</Color>
    <Color x:Key="ControlSelected">#595959</Color>
    <Color x:Key="ControlSecondaryBackground">#333333</Color>
    <Color x:Key="ControlSecondaryHighlight">#434343</Color>
    <Color x:Key="IdealForegroundColor">White</Color>

    <Color x:Key="ButtonBackground">#434343</Color>
    <Color x:Key="ButtonForeground">White</Color>
    <Color x:Key="ButtonDisabledBackground">#333</Color>
    <Color x:Key="ButtonDisabledForeground">#9F9F9F</Color>

    <Color x:Key="AccentTextColor">#FFB300</Color>
    <Color x:Key="PendingBackground">#E47D00</Color>
    <Color x:Key="DeclinedBackground">#F04D2C</Color>
    <Color x:Key="ApprovedBackground">#207820</Color>
    
    <SolidColorBrush x:Key="PendingColorBrush" Color="{StaticResource PendingBackground}"/>
    <SolidColorBrush x:Key="ApprovedColorBrush" Color="{StaticResource ApprovedBackground}"/>
    <SolidColorBrush x:Key="DeclinedColorBrush" Color="{StaticResource DeclinedBackground}"/>

    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{StaticResource PrimaryBackground}"  />
    <SolidColorBrush x:Key="SecondaryColorBrush" Color="{StaticResource SecondaryBackground}"  />
    <SolidColorBrush x:Key="SecondaryHighlightColorBrush" Color="{StaticResource SecondaryHighlight}"  />
    <SolidColorBrush x:Key="TertiaryColorBrush" Color="{StaticResource TertiaryBackground}"  />
    <SolidColorBrush x:Key="TertiaryHighlightColorBrush" Color="{StaticResource TertiaryHighlight}"  />
    <SolidColorBrush x:Key="UrgentColorBrush" Color="{StaticResource Urgent}"  />
    <SolidColorBrush x:Key="UrgentHighlightColorBrush" Color="{StaticResource UrgentHighlight}"  />
    <SolidColorBrush x:Key="ImportantColorBrush" Color="{StaticResource Important}"  />
    <SolidColorBrush x:Key="ImportantHighlightColorBrush" Color="{StaticResource ImportantHighlight}"  />
    <SolidColorBrush x:Key="ControlSelectedBrush" Color="{StaticResource ControlSelected}"  />
    <SolidColorBrush x:Key="ControlSecondaryBackgroundBrush" Color="{StaticResource ControlSecondaryBackground}"  />
    <SolidColorBrush x:Key="ControlSecondaryHighlightBrush" Color="{StaticResource ControlSecondaryHighlight}"  />

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackground}"  />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ButtonForeground}"  />
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="{StaticResource ButtonDisabledBackground}"  />
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="{StaticResource ButtonDisabledForeground}"  />

    <SolidColorBrush x:Key="WindowTitleColorBrush" Color="{StaticResource PrimaryBackground}"  />

    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}"  />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"  />
    <SolidColorBrush x:Key="AccentColorBrush" Color="{StaticResource SecondaryBackground}"  />
    <SolidColorBrush x:Key="AccentColorBrush2" Color="{StaticResource SecondaryHighlight}"  />
    <SolidColorBrush x:Key="AccentColorBrush3" Color="{StaticResource TertiaryBackground}"  />
    <SolidColorBrush x:Key="AccentColorBrush4" Color="{StaticResource TertiaryHighlight}"  />

    <SolidColorBrush x:Key="IdealForegroundColorBrush" Color="{StaticResource IdealForegroundColor}" />
    <SolidColorBrush x:Key="IdealForegroundDisabledBrush" Color="{StaticResource IdealForegroundColor}" Opacity="0.4" />
    <SolidColorBrush x:Key="AccentSelectedColorBrush" Color="{StaticResource IdealForegroundColor}" />


    <Style TargetType="{x:Type UserControl}">
        <Setter Property="Background" Value="{StaticResource Background}"></Setter>
        <Setter Property="Foreground" Value="{StaticResource IdealForegroundColorBrush}"></Setter>
    </Style>
    
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource Background}"></Setter>
        <Setter Property="Foreground" Value="{StaticResource IdealForegroundColorBrush}"></Setter>
    </Style>

    <Style TargetType="{x:Type TextBlock}" >
        <Setter Property="Foreground" Value="{StaticResource IdealForegroundColorBrush}"></Setter>
    </Style>

    <Style x:Key="AutoCompleteItem" TargetType="ListBoxItem" >
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"></Setter>
        <Setter Property="Foreground" Value="{StaticResource ButtonForegroundBrush}"></Setter>
        <Setter Property="BorderThickness" Value="0,0,0,0"></Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="true" >
                <Setter Property="Background" Value="{StaticResource UrgentColorBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="{StaticResource UrgentHighlightColorBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Hyperlink" BasedOn="{StaticResource {x:Type Hyperlink}}">
        <Setter Property="Foreground" Value="LightGray"></Setter>
    </Style>

    <Style TargetType="TabItem" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Header}" Padding="10,6,10,6" Margin="1,0" Background="#FF3A3A3A" Foreground="#FFC7C7C7" Name="PART_TabItem" >
                        </TextBlock>
                        <Border BorderThickness="1" Margin="1,0" Name="PART_Border" Panel.ZIndex="1"></Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_TabItem" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_TabItem" Property="Background" Value="#FF5A5A5A" ></Setter>
                            <Setter TargetName="PART_TabItem" Property="Foreground" Value="White" ></Setter>
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="DarkGray" ></Setter>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_TabItem" Property="Foreground" Value="White"></Setter>
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="DarkOrange"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckedComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Margin="{Binding ItemMargin}" Orientation="Horizontal" HorizontalAlignment="Left">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Width="22" HorizontalAlignment="Left"></CheckBox>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Padding="2"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PSDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="CanUserAddRows" Value="False"></Setter>
        <Setter Property="CanUserDeleteRows" Value="False"></Setter>
        <Setter Property="SelectionMode" Value="Single"></Setter>
        <Setter Property="SelectionUnit" Value="FullRow"></Setter>
        <Setter Property="AlternationCount" Value="2"></Setter>

        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"></Setter>
                    <Setter Property="BorderThickness" Value="0"></Setter>
                    <Style.Resources>
                        <Style TargetType="Hyperlink">
                            <Setter Property="Foreground" Value="{DynamicResource IdealForegroundColorBrush}"></Setter>
                        </Style>
                    </Style.Resources>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"></Setter>
                            <Setter Property="Foreground" Value="{DynamicResource IdealForegroundColorBrush}"></Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource RowBackground}"></Setter>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Background" Value="{DynamicResource RowBackground}"></Setter>
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource AltRowBackground}"></Setter>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter Property="Background" Value="{DynamicResource HighlightBrush}"></Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>

            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource AccentColorBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ButtonForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!--<Setter Property="BorderBrush" Value="{StaticResource ControlSecondaryHighlightBrush}"/>-->
        <Setter Property="BorderBrush" Value="{StaticResource AccentColorBrush2}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="75"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentColorBrush3}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}"></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ButtonDisabledBackgroundBrush}"></Setter>
                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledForegroundBrush}"></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FlatButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        
    </Style>
    
    <Style x:Key="SmallButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="2"></Setter>
        <Setter Property="Padding" Value="6,2"></Setter>
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="Background" Value="#FF303030"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="#FF505050"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="MinWidth" Value="24"></Setter>
    </Style>

    <Style x:Key="VideoControlButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="FontSize" Value="20" /> 
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#000"></Setter>
        <Setter Property="Background" Value="{StaticResource AccentColorBrush2}"></Setter>
        <Setter Property="MinWidth" Value="25"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TertiaryColorBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource HighlightBrush}"></Setter>
                <Setter Property="Foreground" Value="#000"></Setter>
            </Trigger>
        </Style.Triggers>

    </Style>

</ResourceDictionary>